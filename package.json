{
  "name": "maggiemix",
  "version": "2.0.0",
  "private": true,
  "description": "Bilingual (Urdu + English) Pakistani home-recipe chooser. Static site, no framework.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --watch",
    "validate": "node scripts/validate-recipes.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tailwindcss": "3.4.19"
  }
}
